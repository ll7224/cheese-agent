# 大模型相关配置
# 1. Google Gemini (推荐使用 Flashway 等 OpenAI 兼容代理网关接入)
MODEL_PROVIDER=google
MODEL_NAME=gemini-3.8-flash
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
GOOGLE_BASE_URL=https://api.flashway.ai/v1

# 2. 阿里云百炼 DashScope（用于 Qwen 模型和专用 1024 维 RAG 向量化 qwen3.7-text-embedding）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 3. OpenAI 原生 / 中转网关
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 联网搜索 API Key（Tavily 或 Serper，二选一即可）
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# GitHub MCP Server 访问令牌（可选，用于动态挂载 GitHub MCP 工具）
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# 飞书机器人通道配置（可选，支持长连接与 Webhook 模式）
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here
FEISHU_PORT=3000
